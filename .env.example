# Stride Environment Variables

# Secret key for encrypting private session cookies
SESSION_SECRET=super_secret_session_key_subdomain_change_me

# Preset passwords for initial database seeding
STRIDE_OWNER_PASSWORD=stride2026
STRIDE_CLIENT_PASSWORD=client2026

# Vercel Blob Storage Token for Image & File Attachments
# When deploying on Vercel: automatically set when creating a Vercel Blob store.
# When running outside Vercel: generate a token from your Vercel Dashboard -> Storage -> Blob.
# (If omitted, Stride automatically falls back to local storage in public/uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
